# MANIFEST.in - Specify additional files to include in MASARE distribution

# Documentation
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include AUTHORS.md
include CITATION.cff

# Architecture and Legal Documents
include ARCHITECTURE.md
include LEGAL_FRAMEWORK.md

# Documentation directory
recursive-include docs *.md
recursive-include docs *.txt

# Configuration files
include requirements.txt
include pyproject.toml
include setup.py

# Configuration templates
recursive-include analysis/cuckoo/config *.conf *.template
recursive-include infrastructure/firewall *.xml
recursive-include infrastructure/docker *.yml

# Scripts
recursive-include scripts *.sh
recursive-include tests *.sh

# GitHub templates
recursive-include .github *.md *.yml

# Examples
recursive-include examples *.py *.md
include examples/sample_malware/eicar.com
include examples/sample_malware/encrypted_samples/manifest.json

# Exclude build and cache files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp
global-exclude *~

# Exclude sensitive files
exclude .env
exclude .env.*
recursive-exclude * *.gpg
recursive-exclude * *.log
recursive-exclude * id_rsa*
recursive-exclude * *.pem
recursive-exclude * *.key

# Exclude virtual environments and builds
prune venv
prune env
prune build
prune dist
prune *.egg-info
